{
  "name": "pm-server",
  "version": "1.0.0",
  "description": "业绩管理系统后端 - Express + SQLite (node:sqlite)",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
